    { "id": "e10", "from": "handler", "to": "batch_items", "label": "deduplica evento e pessoa" },
    { "id": "e11", "from": "batch_items", "to": "batch", "label": "compõe resumo" },
    { "id": "e12", "from": "batch", "to": "flush", "label": "vence após silêncio curto" },
    { "id": "e13", "from": "flush", "to": "resend", "label": "um envio por lote" }
