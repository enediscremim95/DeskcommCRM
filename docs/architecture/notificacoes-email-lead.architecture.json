    { "id": "e2", "from": "outbox", "to": "handler", "label": "drain assíncrono" },
    { "id": "e3", "from": "configuracao", "to": "preferencias", "label": "opt-out pessoal" },
    { "id": "e4", "from": "preferencias", "to": "handler", "label": "autoriza a categoria" },
